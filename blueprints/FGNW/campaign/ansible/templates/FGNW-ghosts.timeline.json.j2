{#
  Fourth Great Ninja War — per-persona GHOSTS timeline (LOE 1 BAU noise + flagship overrides).
  Rendered once per GHOSTS-client host by ansible/FGNW-ghosts-activity.yml. All persona/topology
  values arrive as vars (nothing host-specific hardcoded):
    ghosts_browse_urls     baseline browsing URLs (generated persona-timelines.yml).
    ghosts_signature_urls  per-character obsession sites; rendered as high-frequency browse events
                           inside the BrowserChrome handler. May be empty.
    ghosts_pace            obsessive | normal | idle — signature browse-event loop speed.
    ghosts_time_on/off     UTC window for the DAY shift (converted from local active_hours).
    ghosts_night_factor    if defined, also emit an after-hours shift on the complementary window.
    ghosts_lunch_on/off/factor  optional midday dip window inside the day window.
    ghosts_ad_domain       this host's AD domain, for the mail / mstsc targets.
    ghosts_submits_reports Leaf personas also open the ninjasploitable mission-report intake page.
    ghosts_recon_legs      akatsuki-ws2 only: nmap sweeps + DoS legs.
    ghosts_admin_activity  boolean: run privileged AD/CLI commands.
    range_second_octet     range number, for the shared-infra IPs (attacker sinkhole 10.<r>.99.50).
  The night shift reuses the SAME events as the day shift (same person working late); its window is
  the exact complement of the day window, so the two never overlap and together cover 24h.
#}
{%- if ghosts_pace | default('normal') == 'obsessive' %}{% set sig_lo = 60 %}{% set sig_hi = 120 %}
{%- elif ghosts_pace | default('normal') == 'idle' %}{% set sig_lo = 480 %}{% set sig_hi = 720 %}
{%- else %}{% set sig_lo = 180 %}{% set sig_hi = 300 %}{% endif %}
{%- set day_on = ghosts_time_on | default('22:30:00') %}
{%- set day_off = ghosts_time_off | default('08:30:00') %}
{#
   The shifts tile the day window (day_on -> day_off). With a lunch window they split into
   morning + lunch(slow) + afternoon so activity dips at midday; otherwise one flat day shift.
   The night shift, if any, is the day's complement (day_off -> day_on).
#}
{%- if ghosts_lunch_on is defined and ghosts_lunch_off is defined %}
{%- set shifts = [{'on': day_on, 'off': ghosts_lunch_on, 'factor': 1.0}, {'on': ghosts_lunch_on, 'off': ghosts_lunch_off, 'factor': ghosts_lunch_factor | float}, {'on': ghosts_lunch_off, 'off': day_off, 'factor': 1.0}] %}
{%- else %}
{%- set shifts = [{'on': day_on, 'off': day_off, 'factor': 1.0}] %}
{%- endif %}
{%- if ghosts_night_factor is defined %}
{%- set _ = shifts.append({'on': day_off, 'off': day_on, 'factor': ghosts_night_factor | float}) %}
{%- endif %}
{%- set ns = namespace(sep='') %}
{
  "Status": "Run",
  "TimeLineHandlers": [
{%- for shift in shifts %}
{%- set f = shift.factor %}
{%- if ghosts_recon_legs is defined %}
{#  LOE 2 recon/vuln-scan/DoS legs (akatsuki-ws2 only): targets Fire+Leaf and Sand, never sourced
    from them — the noisy, expected-to-be-caught precursor, distinct from the real breach's quiet
    credentialed techniques. #}
    {{ ns.sep }}{
      "HandlerType": "Command",
      "Initial": "",
      "UtcTimeOn": "{{ shift.on }}",
      "UtcTimeOff": "{{ shift.off }}",
      "Loop": true,
      "TimeLineEvents": [
        {
          "Command": "nmap.exe -sV -T4 10.{{ range_second_octet }}.{{ ghosts_recon_legs.fire_leaf_subnet_octet }}.0/24",
          "CommandArgs": [],
          "DelayAfter": {{ (((range(180, 481) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        },
        {
          "Command": "nmap.exe -sV -T4 10.{{ range_second_octet }}.{{ ghosts_recon_legs.sand_subnet_octet }}.0/24",
          "CommandArgs": [],
          "DelayAfter": {{ (((range(180, 481) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        },
        {
          "Command": "nmap.exe -sV -T4 --script vuln 10.{{ range_second_octet }}.{{ ghosts_recon_legs.fire_leaf_subnet_octet }}.0/24 10.{{ range_second_octet }}.{{ ghosts_recon_legs.sand_subnet_octet }}.0/24",
          "CommandArgs": [],
          "DelayAfter": {{ (((range(180, 481) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        }{% for t in ghosts_recon_legs.dos_targets %},
        {
          "Command": "powershell.exe -ExecutionPolicy Bypass -File C:\\ludus\\recon-tooling\\cannon-flood.ps1 -TargetHost 10.{{ range_second_octet }}.{{ t.octet }}.{{ t.host }} -TargetPort {{ t.port }} -RatePerSecond {{ ghosts_recon_legs.dos_rate_per_second | default(20) }} -DurationSeconds {{ ghosts_recon_legs.dos_duration_seconds | default(30) }}",
          "CommandArgs": [],
          "DelayAfter": {{ (((range(180, 481) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        }{% endfor %}
      ]
    }
{%- set ns.sep = ',' %}
{%- endif %}
{%- if ghosts_admin_activity | default(false) %}
{#  Fixed privileged AD/CLI commands, gated by admin_activity. Sysmon/ACSC logging captures this as
    real privileged-account activity for blue-team baselines. #}
    {{ ns.sep }}{
      "HandlerType": "Command",
      "Initial": "",
      "UtcTimeOn": "{{ shift.on }}",
      "UtcTimeOff": "{{ shift.off }}",
      "Loop": true,
      "TimeLineEvents": [
        {
          "Command": "powershell.exe -Command \"Get-ADUser -Filter * -ResultSetSize 10 | Out-Null\"",
          "CommandArgs": [],
          "DelayAfter": {{ (((range(600, 1201) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        },
        {
          "Command": "powershell.exe -Command \"Get-ADGroupMember -Identity 'Domain Admins' | Out-Null\"",
          "CommandArgs": [],
          "DelayAfter": {{ (((range(600, 1201) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        },
        {
          "Command": "cmd /c gpupdate /force",
          "CommandArgs": [],
          "DelayAfter": {{ (((range(900, 1801) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        },
        {
          "Command": "cmd /c start \"\" dsa.msc",
          "CommandArgs": [],
          "DelayAfter": {{ (((range(900, 1801) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        },
        {
          "Command": "cmd /c start \"\" mstsc /v:{{ {'fire.ninja': 'fire-dc1', 'konohagakure.fire.ninja': 'konoha-dc1', 'sunagakure.wind.ninja': 'suna-dc1', 'wind.ninja': 'wind-dc1', 'otogakure.ninja': 'oto-dc1', 'akatsuki.dark': 'akatsuki-dc1'}[ghosts_ad_domain] | default('konoha-dc1') }}",
          "CommandArgs": [],
          "DelayAfter": {{ (((range(1200, 2401) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        }
      ]
    }
{%- set ns.sep = ',' %}
{%- endif %}
{#  One GHOSTS-native BrowserChrome handler: sinkhole landing + browse_urls + signature_urls, the
    optional Leaf mission-report intake, and the OWA login-page open. Drives a real Selenium Chrome
    in the persona's interactive session (isheadless false). The sinkhole browse is first and
    unconditional, so every later event leads with a comma; this handler is the per-shift comma
    anchor (consumes ns.sep, then sets it to ',' for later handlers and the next shift). #}
    {{ ns.sep }}{
      "HandlerType": "BrowserChrome",
      "Initial": "about:blank",
      "UtcTimeOn": "{{ shift.on }}",
      "UtcTimeOff": "{{ shift.off }}",
      "Loop": true,
      "HandlerArgs": {
        "isheadless": "false",
        "blockimages": "true",
        "stickiness": 75,
        "stickiness-depth-min": 5,
        "stickiness-depth-max": 10
      },
      "TimeLineEvents": [
        {
          "Command": "browse",
          "CommandArgs": ["http://10.{{ range_second_octet }}.99.50/"],
          "DelayAfter": {{ (((range(150, 271) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        }{% for url in ghosts_browse_urls %},
        {
          "Command": "browse",
          "CommandArgs": ["{{ url }}"],
          "DelayAfter": {{ (((range(120, 301) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        }{% endfor %}{% for url in ghosts_signature_urls | default([]) %},
        {
          "Command": "browse",
          "CommandArgs": ["http://{{ url }}"],
          "DelayAfter": {{ (((range(sig_lo, sig_hi + 1) | random) * 1000) * f) | round | int }},
          "DelayBefore": 0
        }{% endfor %}{% if ghosts_submits_reports | default(false) %},
        {
          "Command": "browse",
          "CommandArgs": ["http://10.{{ range_second_octet }}.90.10/reports/intake.php"],
          "DelayAfter": {{ (180000 * f) | round | int }},
          "DelayBefore": 0
        }{% endif %},
        {
          "Command": "browse",
          "CommandArgs": ["https://mail.{{ ghosts_ad_domain }}/owa/auth/logon.aspx"],
          "DelayAfter": {{ (180000 * f) | round | int }},
          "DelayBefore": 0
        }
      ]
    }
{%- set ns.sep = ',' %}
{%- endfor %}
  ]
}

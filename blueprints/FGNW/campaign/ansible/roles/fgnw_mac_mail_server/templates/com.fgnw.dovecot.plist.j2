<?xml version="1.0" encoding="UTF-8"?>
<!-- {{ ansible_managed }} -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{{ fgnw_mac_mail_server_dovecot_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ fgnw_mac_mail_server_dovecot_prefix }}/sbin/dovecot</string>
    <string>-F</string>
    <string>-c</string>
    <string>{{ fgnw_mac_mail_server_dovecot_prefix }}/dovecot.conf</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>SoftResourceLimits</key>
  <dict><key>NumberOfFiles</key><integer>4096</integer></dict>
  <key>StandardErrorPath</key><string>{{ fgnw_mac_mail_server_dovecot_prefix }}/dovecot.stderr.log</string>
</dict>
</plist>

{{ ansible_managed | comment }}
[Unit]
Description=zeekctl cron — log rotation, expiry and worker crash recovery
After=zeek-sensor.service
Requires=zeek-sensor.service
[Service]
Type=oneshot
{% if zeek_sensor_user != 'root' %}
User={{ zeek_sensor_user }}
Group={{ zeek_sensor_group }}
{% endif %}
Environment=HOME=/
ExecStart={{ zeek_sensor_bin }} cron

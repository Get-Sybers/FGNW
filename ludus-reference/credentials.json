{
  "_comment": "Credentials Ludus uses to reach a deployed VM, keyed by the OS id the QEMU guest agent reports (os-release ID; mswindows -> windows). A template whose baked-in account differs cannot be configured by `ludus range deploy`. Source: ludus-server/ansible/range-management/group_vars/*.yml. Regenerate with `make update-reference`.",
  "groups": {
    "almalinux": {
      "user": "localuser",
      "password": "password",
      "connection": "ssh"
    },
    "centos": {
      "user": "localuser",
      "password": "password",
      "connection": "ssh"
    },
    "debian": {
      "user": "debian",
      "password": "debian",
      "connection": "ssh"
    },
    "kali": {
      "user": "kali",
      "password": "kali",
      "connection": "ssh"
    },
    "macos": {
      "user": "localuser",
      "password": "password",
      "connection": "ssh"
    },
    "osx": {
      "user": "localuser",
      "password": "password",
      "connection": "ssh"
    },
    "rhel": {
      "user": "localuser",
      "password": "password",
      "connection": "ssh"
    },
    "rocky": {
      "user": "root",
      "password": "root",
      "connection": "ssh"
    },
    "ubuntu": {
      "user": "localuser",
      "password": "password",
      "connection": "ssh"
    },
    "windows": {
      "user": "localuser",
      "password": "password",
      "connection": "winrm (HTTPS, port 5986)"
    }
  },
  "convention": "localuser:password unless the OS has a reason not to (docs/docs/using-ludus/templates.md)"
}
